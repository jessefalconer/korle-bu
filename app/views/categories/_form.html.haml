= form_for @category do |f|
  .row
    .col-12.col-sm-4
      .form-group
        %label Name
        = f.text_field :name, class: "form-control"
    .col-12.col-sm-8
      .form-group
        %label Description
        = f.text_field :description, class: "form-control"

    .col-12
      .btn-toolbar.list-toolbar
        = submit_button_responsive("Save")
