.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Categories
    = render partial: "layouts/jump_to_modal"
    = add_button(new_category_path, "Category", "fa-file-medical")
  .main-content
    %table.table.table-striped.table-hover.link-rows
      %thead
        %tr
          %th Name
          %th.d-none.d-sm-table-cell Description
      %tbody
        - @categories.each do |category|
          %tr
            %td
              = link_to category_path(category) do
                %p= category.name
            %td.d-none.d-sm-table-cell
              = link_to category_path(category) do
                %p= category.description

    = paginate @categories, window: 2
