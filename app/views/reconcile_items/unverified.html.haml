.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Reconcile - Unverified
    = render partial: "layouts/jump_to_modal"
    = link_refresh_button(reconcile_unverified_path, "Clear Results", "fa-arrows-rotate")
  .main-content
    .row
      .col-12
        = render "progress", progress: @progress
      .col-12
        - if @items.any?
          = render partial: "items/search_form", locals: { path: "/unverified_item_search" }
          %table.table.table-striped.table-hover.link-rows
            %thead
              %tr
                %th Name
                %th.d-none.d-sm-table-cell Category
                %th Instances
            %tbody#search-results
              = render "unverified_table"

          = paginate @items

        - else
          %h4.text-center All caught up! &#127881;
