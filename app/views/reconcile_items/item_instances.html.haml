.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to index_path do
          Home
      %li.breadcrumb-item.active Item Activity for #{@item.generated_name}
    = render partial: "layouts/jump_to_modal"
  .main-content
    .row
      .col-12
        - if @container_items.none? && @pallet_items.none? && @box_items.none? && @staged_items.none?
          %h4.text-center
            No item history
            %i.fa.fa-fw.fa-clock-rotate-left
            to display.
        - else
          - if @staged_items.any?
            .card
              %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#staged_items"}
                %i.fa.fa-stethoscope
                Staged Items
                %span.badge.text-bg-info= @staged_items.size
              .collapse{id: "staged_items"}
                %table.table.table-striped
                  %tbody
                    %thead
                      %tr
                        %th.d-none.d-sm-table-cell Quantity
                        %th Name
                        %th.d-none.d-sm-table-cell
                        %th Staging
                        %th Date
                    - @staged_items.each do |item|
                      %tr
                        %td.d-none.d-sm-table-cell
                          %p= item.quantity
                        %td
                          = link_to item_path(item.item_id) do
                            = item.generated_name
                        %td.text-center.d-none.d-sm-table-cell
                          %i.fa.fa-arrow-right
                        %td
                          = link_to staged_items_path do
                            Staging Area
                        %td
                          %p= item.created_at.strftime("%Y-%m-%d")
          - if @warehoused_items.any?
            .card
              %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#staged_items"}
                %i.fa.fa-stethoscope
                Staged Items
                %span.badge.text-bg-info= @warehoused_items.size
              .collapse{id: "staged_items"}
                %table.table.table-striped
                  %tbody
                    %thead
                      %tr
                        %th.d-none.d-sm-table-cell Quantity
                        %th Name
                        %th.d-none.d-sm-table-cell
                        %th Staging
                        %th Date
                    - @warehoused_items.each do |item|
                      %tr
                        %td.d-none.d-sm-table-cell
                          %p= item.quantity
                        %td
                          = link_to item_path(item.item_id) do
                            = item.generated_name
                        %td.text-center.d-none.d-sm-table-cell
                          %i.fa.fa-arrow-right
                        %td
                          = link_to warehoused_items_path do
                            Warehouse Area
                        %td
                          %p= item.created_at.strftime("%Y-%m-%d")
          - if @box_items.any?
            .card
              %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#box_items"}
                %i.fa.fa-box-open
                Boxed Items
                %span.badge.text-bg-info= @box_items.size
              .collapse{id: "box_items"}
                %table.table.table-striped
                  %tbody
                    %thead
                      %tr
                        %th.d-none.d-sm-table-cell Quantity
                        %th Name
                        %th.text-center.d-none.d-sm-table-cell To
                        %th Box
                        %th Date
                    - @box_items.each do |item|
                      %tr
                        %td.d-none.d-sm-table-cell
                          %p= item.quantity
                        %td
                          = link_to item_path(item.item_id) do
                            = item.generated_name
                        %td.text-center.d-none.d-sm-table-cell
                          %i.fa.fa-arrow-right
                        %td
                          = link_to box_path(item.box) do
                            = item.box.name
                        %td
                          %p= item.created_at.strftime("%Y-%m-%d")

          - if @pallet_items.any?
            .card
              %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#pallet_items"}
                %i.fa.fa-pallet
                Palletized Items
                %span.badge.text-bg-info= @pallet_items.size
              .collapse{id: "pallet_items"}
                %table.table.table-striped
                  %tbody
                    %thead
                      %tr
                        %th.d-none.d-sm-table-cell Quantity
                        %th Name
                        %th.text-center.d-none.d-sm-table-cell To
                        %th Pallet
                        %th Date
                    - @pallet_items.each do |item|
                      %tr
                        %td.d-none.d-sm-table-cell
                          %p= item.quantity
                        %td
                          = link_to item_path(item.item_id) do
                            = item.generated_name
                        %td.text-center.d-none.d-sm-table-cell
                          %i.fa.fa-arrow-right
                        %td
                          = link_to pallet_path(item.pallet) do
                            = item.pallet.name
                        %td
                          %p= item.created_at.strftime("%Y-%m-%d")

          - if @container_items.any?
            .card
              %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#container_items"}
                %i.fa.fa-truck
                Containerized Items
                %span.badge.text-bg-info= @container_items.size
              .collapse{id: "container_items"}
                %table.table.table-striped
                  %tbody
                    %thead
                      %tr
                        %th.d-none.d-sm-table-cell Quantity
                        %th Name
                        %th.text-center.d-none.d-sm-table-cell To
                        %th Container
                        %th Date
                    - @container_items.each do |item|
                      %tr
                        %td.d-none.d-sm-table-cell
                          %p= item.quantity
                        %td
                          = link_to item_path(item.item_id) do
                            = item.generated_name
                        %td.text-center.d-none.d-sm-table-cell
                          %i.fa.fa-arrow-right
                        %td
                          = link_to container_path(item.container) do
                            = item.container.name
                        %td
                          %p= item.created_at.strftime("%Y-%m-%d")
