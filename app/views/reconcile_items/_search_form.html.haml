.input-group.search.span12.padding-bottom-small
  = hidden_field_tag :compare_id, @item.id, {id: "compare-id", data: {similar_ids: @similar_items.map(&:id)}}
  .input-group
    = text_field_tag :search, params[:search], placeholder: "Enter search term...", class: "form-control", id: "search-params"
    %a.btn.btn-primary.responsive-button#reconcile-search-submit
      %span Search
      %i.fa.fa-magnifying-glass

#search-results
