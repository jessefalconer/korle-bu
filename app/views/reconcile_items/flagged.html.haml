.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Reconcile - Flagged
    = render partial: "layouts/jump_to_modal"
  .main-content
    .row
      .col-12
        = render "progress", progress: @progress
      .col-12
        - if @items.any?
          %table.table.table-striped.table-hover.link-rows
            %thead
              %tr
                %th Name
                %th Verified
                %th.d-none.d-sm-table-cell Category
                %th Instances
            %tbody
              - counts = instance_counts(@items)
              - @items.each do |item|
                %tr
                  %td
                    %p{data: {"bs-target": "#item-#{item.id}Modal", "bs-toggle": "modal"}}
                      = item.generated_name
                  %td
                    %p{data: {"bs-target": "#item-#{item.id}Modal", "bs-toggle": "modal"}, class: item.verified ? "text-success" : "text-danger"}
                      = item.verified.to_s.capitalize
                  %td.d-none.d-sm-table-cell
                    %p{data: {"bs-target": "#item-#{item.id}Modal", "bs-toggle": "modal"}}
                      = item.category&.name || "N/A"
                  %td
                    = link_to item_instances_path(item) do
                      %p.instances= counts.fetch(item.id, 0)

                = render partial: "layouts/item_edit_modal", locals: {item: item, redirect: "reconcile_flagged_path"}

          = paginate @items

        - else
          %h4.text-center All caught up! &#127881;
