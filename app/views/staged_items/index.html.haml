.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Staged Items
    = render partial: "layouts/jump_to_modal"
    - if can? :manage, PackedItem
      = render partial: "layouts/mass_action_modal", locals: {name: "staged items", redirect: staged_items_path, record: nil }

  .main-content
    %ul.nav.nav-tabs
      - if can? :manage, PackedItem
        %li.nav-item
          %a.nav-link.active{data: {"bs-toggle": "tab"}, href: "#search"} Search
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#new"} New
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#manage-items"}
            Manage
            %span.badge.text-bg-success= @packed_items.count
    .row
      .col-12
        %br
        .tab-content
          - if can? :manage, PackedItem
            .tab-pane.fade#manage-items
              = render "manage_form"

            .tab-pane.active.show#search
              = render "search_form"

            .tab-pane.fade#new
              = render "add_new_form"
