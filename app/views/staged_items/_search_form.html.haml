%h5 Search for an existing item in the database to stage.
.input-group.search.span12
  = hidden_field_tag :model, "Staged", id: "search-model"
  = hidden_field_tag :status, "Staged", id: "status"
  .input-group
    = text_field_tag :search, params[:search], placeholder: "Begin typing to search...", class: "form-control", id: "search-params"
    %a.btn.btn-primary.responsive-button#packing-search-submit
      %i.fa.fa-magnifying-glass
      %span Search

#search-results
