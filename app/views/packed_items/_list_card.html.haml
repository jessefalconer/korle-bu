.row.inline-add-item
  .col-12.manage-item-name{data: {item_id: pi.item.id}}
    %p
      = pi.generated_name
      - if pi.show_id
        —
        %em.show-id ID: ##{pi.id}
    .drawer-info
      %span.badge.text-bg-success= pi.quantity
      %i.fa.fa-chevron-down.drawer-caret
  .col-12.manage-item-form.hidden
    .row
      .col-6.col-sm-4.col-lg-3
        %h5.text-muted Received Quantity
        %h4= pi.quantity
      .col-6.col-sm-4.col-lg-3
        %h5.text-muted Remaining Quantity
        %h4= pi.remaining_quantity
      .col-6.col-sm-4.col-lg-3
        %h5.text-muted Received Weight
        %h4= pi.weight || "N/A"
      - if pi.expiry_date
        .col-6.col-sm-4.col-lg-3
          %h5.text-muted Expires
          %h4= pi.expiry_date.strftime("%Y-%m-%d") || "N/A"
