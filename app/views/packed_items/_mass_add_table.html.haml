%table.table.table-striped.table-hover
  %thead
    %tr
      %th Name
      %th.d-none.d-sm-table-cell ID
      %th.d-none.d-sm-table-cell Quantity
      %th.d-none.d-sm-table-cell Weight
      %th Expires
      %th.mass-action-cell
  %tbody
    - items.each do |item|
      %tr
        %td
          %p= item.generated_name
        %td.d-none.d-sm-table-cell
          %p= item.show_id ? item.id : ""
        %td.d-none.d-sm-table-cell
          %p= item.quantity
        %td.d-none.d-sm-table-cell
          %p= item.weight.to_f.zero? ? "N/A" : "#{item.weight}kg"
        %td
          %p= item.expiry_date&.strftime("%Y-%m-%d") || "N/A"
        %td.mass-action-cell
          = check_box_tag "packed_item_ids[]", item.id, false, class: "mass-action-table", form: "mass_action", id: "mass-action-packed-item-#{item.id}"
