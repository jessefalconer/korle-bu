- items.each do |(item, packed_items)|
  .row.inline-add-item
    .col-12.manage-item-name
      %p= item.generated_name
      .drawer-info
        - if packed_items.size > 4
          %span.d-none.d-md-inline #{packed_items.map(&:location_name).uniq.pop(3).join(", ")} and #{packed_items.size - 3} others
        - else
          %span.d-none.d-md-inline= packed_items.map(&:location_name).uniq.join(", ")
        %span.badge.text-bg-info= packed_items.sum(&:remaining_quantity)
        %i.fa.fa-chevron-down.drawer-caret
    .col-12.manage-item-form.hidden
      .row
        .col-12
          - if item.notes.present?
            = link_to item_path(item) do
              %h5.text-info Additional Information Available
          - if item.category
            %h5.text-success Category: #{item.category.name}
          - else
            %h5.text-danger Category: N/A
      - packed_items.each do |pi|
        = form_for :unpacking_event, url: present(pi).unpack_path do |f|
          .row
            .col-4.col-md-3.col-lg-2
              %h4.text-muted
                Located in
                %i.fa.fa-turn-down
              %h5= present(pi.parent).breadcrumbs
              - if pi.show_id
                %p
                  %em.show-id ID: ##{pi.id}
            .col-8.col-md-9.col-lg-10
              .row
                .col-12.col-md-4
                  .form-group
                    %label Unpacking Quantity
                    = f.number_field :quantity, value: pi.remaining_quantity, class: "form-control", min: 1, max: pi.remaining_quantity, id: "quantity-#{pi.id}"
                .col-12.col-md-4
                  .form-group
                    %label Hospital/Facility/Clinic
                    = f.select :hospital_id, hospital_options, { include_blank: "None" }, { class: "form-select", id: "hospital-assignment-#{pi.id}" }
                .col-12.col-md-4
                  .form-group
                    %label Unpacked On
                    - today = DateTime.current.in_time_zone("Pacific Time (US & Canada)").strftime("%Y-%m-%d")
                    = f.date_field :timestamp, value: today, class: "form-control"
                -# Notes fill the row; Unpack sits at its end, level with the input
                .col-12
                  .row.align-items-end.inline-submit-row
                    .col
                      .form-group
                        = f.label "Notes"
                        = f.text_field :notes, class: "form-control", placeholder: "Explanation", id: "explanation-#{pi.id}"
                    .col-auto
                      .form-group
                        = submit_button_responsive("Unpack")
      %h6.float-end
        %a{data: {"bs-target": "#add-hospital-modal", "bs-toggle": "modal"}, href: ""} Don't see your hospital/facility/clinic? Add one.
