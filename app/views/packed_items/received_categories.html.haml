.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Items by Category
    = render partial: "layouts/jump_to_modal"
  .main-content
    %h5 Select a category to narrow down your search.
    %table.table.table-striped.table-hover.link-rows
      %thead
        %tr
          %th Name
          %th Description
          %th Items
          %th Remaining
      %tbody
        - @category_totals.each do |(category, totals)|
          %tr
            %td
              = link_to received_category_items_path(category) do
                %p= category.name
            %td
              = link_to received_category_items_path(category) do
                %p= category.description
            %td
              = link_to received_category_items_path(category) do
                %p= totals[:item_count]
            %td
              = link_to received_category_items_path(category) do
                %p= totals[:remaining]
        - if @uncategorized_totals[:item_count].positive?
          %tr
            %td
              = link_to received_uncategorized_items_path do
                %p.text-danger Uncategorized
            %td
              = link_to received_uncategorized_items_path do
                %p.text-danger N/A
            %td
              = link_to received_uncategorized_items_path do
                %p= @uncategorized_totals[:item_count]
            %td
              = link_to received_uncategorized_items_path do
                %p= @uncategorized_totals[:remaining]
