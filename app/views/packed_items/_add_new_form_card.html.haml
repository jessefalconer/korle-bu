.row.padding-top-small
  .col-6.col-sm-3
    .form-group
      %label Quantity
      = f.number_field :quantity, value: 1, min: 1, class: "form-control"
      = f.hidden_field :staged, value: staged
  .col-6.col-sm-3
    .form-group
      %label Weight (kg)
      = f.number_field :weight, value: 0, min: 0, step: :any, class: "form-control"
  .col-6.col-sm-3
    .form-group
      %label Expiry Date
      = f.date_field :expiry_date, value: "", class: "form-control"
  .col-6.col-sm-3
    .form-group
      %label.checkbox-option.inline-field
        = f.check_box :show_id
        Generate ID?
%h5 Complete the new item's general information below.
= render partial: "items/form", locals: { item: Item.new, submit_path: "item" }
