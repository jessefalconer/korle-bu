.row.inline-add-item
  .col-12.manage-item-name
    %p
      = pi.generated_name
      - if pi.show_id
        —
        %em.show-id ID: ##{pi.id}
    .drawer-info
      %span.badge.text-bg-info= pi.remaining_quantity
      %i.fa.fa-chevron-down.drawer-caret
  .col-12.manage-item-form.hidden
    .row
      .col-12.col-md-4
        .form-group
          %label Unpacking Quantity
          = f.number_field :quantity, value: pi.remaining_quantity, class: "form-control", min: 1, max: pi.remaining_quantity, id: "quantity-#{pi.id}"
      .col-12.col-md-4
        .form-group
          %label Hospital/Facility/Clinic
          = f.select :hospital_id, hospital_options, { include_blank: "None" }, { class: "form-select", id: "hospital-assignment-#{pi.id}" }
        %h6
          %a{data: {"bs-target": "#add-hospital-modal", "bs-toggle": "modal"}, href: ""} Don't see your hospital/facility/clinic? Add one.
      .col-12.col-md-4
        .form-group
          %label Unpacked On
          = f.date_field :timestamp, value: unpack_date, class: "form-control"
      -# Notes fill the row; Unpack sits at its end, level with the input
      .col-12
        .row.align-items-end.inline-submit-row
          .col
            .form-group
              = f.label "Notes"
              = f.text_field :notes, class: "form-control", placeholder: "Explanation", id: "explanation-#{pi.id}"
          .col-auto
            .form-group
              = submit_button_responsive("Unpack")
