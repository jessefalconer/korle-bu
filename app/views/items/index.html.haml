.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Items
    = render partial: "layouts/jump_to_modal"
    = add_button(new_item_path, "Item", "fa-stethoscope")
    = link_refresh_button(items_path, "Clear Results", "fa-sync")
  .main-content
    = render partial: "search_form", locals: { path: "/index_item_search" }
    - if @items.any?
      %table.table.table-striped.table-hover.link-rows
        %thead
          %tr
            %th Name
            %th.d-none.d-sm-table-cell Category
            %th.d-none.d-sm-table-cell Verified
        %tbody#search-results
          = render "table"
    - else
      %h4.text-center
        No results
        %i.fa.fa-stethoscope
        found.

    = paginate @items, window: 2
