.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      = present(@container).breadcrumbs
    = render partial: "layouts/jump_to_modal"
    - if can? :manage, Container
      = render partial: "layouts/edit_modal"
    - if can? :read, PackedItem
      = manage_button(container_container_items_path(@container), "Items")
    - if can? :manage, PackedItem
      = render partial: "layouts/mass_action_modal", locals: {name: @container.name, redirect: container_path(@container), record: @container}
    - if can? :destroy, @container
      = delete_button(container_path(@container), "Are you sure you want to delete #{@container.name}? This cannot be reversed")

  .main-content
    .row.detail-layout
      .col-md-5
        .row.detail-card
          .col-12
            %h5.text-muted Name
            %h4= @container.name
          - if @container.notes.present?
            .col-12
              %h6.text-muted Notes
              %h5= @container.notes
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Custom ID
            %h5= @container.custom_uid
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Status
            = status_label(@container.status, :h5)
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Weight (kg)
            %h5= @container.weight.to_f.round(4) || "N/A"
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created By
            %h5= @container.user.name
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created At
            %h5= @container.created_at.strftime("%Y-%m-%d")

      .col-md-7
        - present(@container) do |container|
          .card
            %a.card-header{data: {"bs-toggle": "collapse"}, href: "#location"}
              %i.fa.fa-location-dot
              Location Details
            .collapse.show#location
              %table.table.list
                %tbody
                  %tr
                    %td
                      %p Warehouse
                    = container.warehouse_location
                  %tr
                    %td
                      %p Shipment
                    = container.shipment_location

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#pallets"}
            %i.fa.fa-pallet
            Pallets in this Container
            %span.badge{class: @container.pallets.any? ? "text-bg-success" : "text-bg-warning"}= @container.pallets.size

          - if @container.pallets.any?
            .collapse#pallets
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "pallets"}
              = render partial: "pallets/micro_table", locals: {pallets: @container.pallets}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#pallets"}
                %span Close
          - else
            .collapse.card-body#pallets
              %h5.text-center
                No pallets
                %i.fa.fa-fw.fa-pallet
                in this
                %i.fa.fa-fw.fa-truck
                container

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#boxes"}
            %i.fa.fa-box-open
            Boxes in this Container
            %span.badge{class: @container.boxes.any? ? "text-bg-success" : "text-bg-warning"}= @container.boxes.size

          - if @container.boxes.any?
            .collapse#boxes
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "boxes"}
              = render partial: "boxes/micro_table", locals: {boxes: @container.boxes, table_id: "filter-boxes-table"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#boxes"}
                %span Close
          - else
            .collapse.card-body#boxes
              %h5.text-center
                No boxes
                %i.fa.fa-fw.fa-box-open
                in this
                %i.fa.fa-fw.fa-truck
                container

        .card
          %a.card-header.collapsed{class: (@container.container_items.size > 5 && "collapsed"),data: {"bs-toggle": "collapse"}, href: "#packed-items"}
            %i.fa.fa-stethoscope
            Containerized Items
            %span.badge{class: @container.container_items.any? ? "text-bg-success" : "text-bg-warning"}= @container.container_items.size

          - if @container.container_items.any?
            .collapse#packed-items{class: (@container.container_items.size < 6 && "show")}
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "packed-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @container.container_items, assoc: "packed-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#packed-items"}
                %span Close
          - else
            .collapse.card-body#packed-items
              %h5.text-center
                No packed items
                %i.fa.fa-fw.fa-stethoscope
                in this
                %i.fa.fa-fw.fa-truck
                container

  - if (can? :manage, PackedItem) && (@staged_items.any? || @staged_boxes.any? || @staged_pallets.any? || @warehoused_items.any? || @warehoused_boxes.any? || @warehoused_pallets.any?)
    = render "layouts/mass_action_add", display: %i[items boxes pallets]
