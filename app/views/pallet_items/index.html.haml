.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      = present(@pallet).breadcrumbs_item
    = render partial: "layouts/jump_to_modal"
    = render partial: "layouts/mass_action_modal", locals: {name: @pallet.name, redirect: pallet_pallet_items_path(@pallet), record: nil}
  .main-content
    %ul.nav.nav-tabs
      - if can? :manage, PackedItem
        %li.nav-item
          %a.nav-link.active{data: {"bs-toggle": "tab"}, href: "#search"} Search
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#new"} New
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#manage-items"}
            Manage
            %span.badge.text-bg-success= @pallet.pallet_items.count
      - elsif cannot? :manage, PackedItem
        %li.nav-item
          %a.nav-link.active{data: {"bs-toggle": "tab"}, href: "#manage-items"}
            Inventory
            %span.badge.text-bg-success= @pallet.pallet_items.count
      - if can? :manage, UnpackingEvent
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#unpack-items"}
            Unpack
            %span.badge.text-bg-info= @pallet.pallet_items.with_inventory.count
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#history-items"}
            History
            %span.badge.text-bg-secondary= @pallet.pallet_items.with_events.count

    .row
      .col-12
        %br
        .tab-content
          - if can? :manage, PackedItem
            .tab-pane.fade#manage-items
              = render "pallet_items/manage_form"

            .tab-pane.active.show#search
              = render "pallet_items/search_form"

            .tab-pane.fade#new
              = render "pallet_items/add_new_form"

          - elsif cannot? :manage, PackedItem
            .tab-pane.active.show#manage-items
              = render "pallet_items/list"

          - if can? :manage, UnpackingEvent
            .tab-pane.fade#unpack-items
              = render "pallet_items/unpack_form"

            .tab-pane.fade#history-items
              = render "pallet_items/history"
