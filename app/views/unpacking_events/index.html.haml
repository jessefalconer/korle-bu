.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Unpacking History for #{current_user.warehouse.name}
    = render partial: "layouts/jump_to_modal"
    - if can? :manage, Shipment
      = render "layouts/export_unpacking_events_modal"
  .main-content
    - if @events.any?
      %table.table.table-striped.table-hover.link-rows
        %thead
          %tr
            %th Item
            %th Quantity
            %th Origin
            %th.d-none.d-sm-table-cell Destination
            %th.d-none.d-sm-table-cell User
            %th Unpacked On
            %th.d-none.d-md-table-cell Created At
        %tbody
          - @events.each do |event|
            %tr
              %td
                = link_to present(event.packed_item).path do
                  %p= event.generated_name
              %td
                = link_to present(event.packed_item).path do
                  %p= event.quantity
              %td
                = link_to present(event.packed_item).path do
                  %p= event.packed_item.location_name
              %td.d-none.d-sm-table-cell
                = link_to present(event.packed_item).path do
                  %p= event.hospital.name
              %td.d-none.d-sm-table-cell
                = link_to present(event.packed_item).path do
                  %p= event.user.name
              %td
                = link_to present(event.packed_item).path do
                  %p= event.timestamp.strftime("%Y-%m-%d")
              %td.d-none.d-md-table-cell
                = link_to present(event.packed_item).path do
                  %p= event.created_at.strftime("%Y-%m-%d")

      = paginate @events, window: 2

    - else
      %h4.text-center
        No history
        %i.fa.fa-fw.fa-clock-rotate-left
        to display.
