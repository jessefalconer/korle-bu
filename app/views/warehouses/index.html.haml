.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Warehouses
    = render partial: "layouts/jump_to_modal"
    = add_button(new_warehouse_path, "Warehouse")
  .main-content
    %table.table.table-striped.table-hover.link-rows
      %thead
        %tr
          %th Name
          %th.d-none.d-sm-table-cell City
          %th Country
          %th Status
      %tbody
        - @warehouses.each do |warehouse|
          %tr
            %td
              = link_to warehouse_path(warehouse) do
                %p= warehouse.name
            %td.d-none.d-sm-table-cell
              = link_to warehouse_path(warehouse) do
                %p= warehouse.city
            %td
              = link_to warehouse_path(warehouse) do
                %p= warehouse.country
            %td
              = link_to warehouse_path(warehouse) do
                = status_label(warehouse.status, color_class: warehouse.active? ? "text-success" : "text-danger")

    = paginate @warehouses
