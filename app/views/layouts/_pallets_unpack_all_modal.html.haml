= render partial: "layouts/add_hospital_modal", locals: {redirect: pallet_pallet_items_path(@pallet)}
%button.btn.btn-primary.responsive-button{data: {"bs-target": "#unpack-all", "bs-toggle": "modal"}}
  %i.fa.fa-truck-ramp-box
  %span.main-text Unpack All
.modal.fade{id: "unpack-all", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#unpackModalLabel Unpack all items in #{@pallet.name}.
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#unpackModalBody
        .row.mass-action-form
          - unless @pallet.received?
            .col-12
              %i.fas.fa-triangle-exclamation.text-warning
              This pallet has not been received. Check its status.
          .col-12
            %h5 Send #{@pallet.pallet_items.size} item(s) to the selected hospital/facility/clinic:

          = form_for @pallet, url: pallets_unpack_all_path(@pallet), method: :post do |f|
            .row
              .col-12
                .form-group
                  %label Hospital/Facility/Clinic
                  = select_tag("hospital_id", hospital_options, { include_blank: true, class: "form-select" })
                .form-group
                  %label Unpacked On
                  = date_field_tag :timestamp, unpack_date, class: "form-control"
                .form-group
                  %label Notes
                  = text_field_tag :notes, nil, placeholder: "Explanation", class: "form-control"
                %h6
                  %a{href: "#", data: {"switch-modal": "#add-hospital-modal"}} Don't see your clinic or hospital? Add one.
              .col-12
                = submit_button_responsive("Update", "float-end")
