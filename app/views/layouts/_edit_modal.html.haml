- record = @box || @pallet || @container || @shipment || @category || @item || @warehouse || @hospital || @user
-# lol its agile
%button.btn.btn-primary.responsive-button{data: {"bs-target": "#edit-modal", "bs-toggle": "modal"}}
  %i.fa.fa-edit
  %span.main-text Edit
.modal.fade{id: "edit-modal"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#assignmentModalLabel Edit #{record.try(:name) || record.generated_name }
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#assignmentModalBody
        .row.edit-modal-body
          .col-12
            = render "form"
