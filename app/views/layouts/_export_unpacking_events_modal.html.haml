%button.btn.btn-primary{data: {"bs-target": "#export-modal", "bs-toggle": "modal"}}
  %span Export
  %i.fa.fa-file-export
.modal.fade{id: "export-modal", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#assignmentModalLabel Export Unpacking Events
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#assignmentModalBody
        .row.edit-modal-body
          .col-12
            = form_for :unpacking_events_export, url: unpacking_events_exports_path do |f|
              %h5 Choose a date range. Leave blank for maximum ranges:
              .row
                .col-6
                  .form-group
                    = f.label :start_date
                    = f.date_field :start_date, value: (DateTime.now - 1.month).strftime("%Y-%m-%d"), class: "form-control"
                .col-6
                  .form-group
                    = f.label :end_date
                    = f.date_field :end_date, value: DateTime.now.strftime("%Y-%m-%d"), class: "form-control"
              %h5 Date sorting:
              %label.radio-option
                = f.radio_button :sorting, "desc", checked: true
                Descending
              %label.radio-option
                = f.radio_button :sorting, "asc"
                Ascending
              %h5 Optionally filter results by hospital/facility/clinic:
              .form-group
                = f.select :hospital_id, options_from_collection_for_select(Hospital.all.order(:name), :id, :name), { include_blank: "All" }, { class: "form-select" }
              = submit_export
