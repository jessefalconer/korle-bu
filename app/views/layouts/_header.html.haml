%nav.navbar.navbar-expand-sm.navbar-dark
  .container-fluid
    = link_to "KBNF Inventory", index_path, class: "navbar-brand"

    - if current_user
      %button.navbar-toggler.collapsed{type: "button", data: {"bs-target": "#main-nav", "bs-toggle": "collapse"}, aria: {controls: "main-nav", expanded: "false", label: "Toggle navigation"}}
        %span.navbar-toggler-icon
      .collapse.navbar-collapse#main-nav
        %ul.navbar-nav.ms-auto#main-menu
          %li.nav-item.dropdown.d-none.d-sm-block
            %a.nav-link.dropdown-toggle{href: "#", role: "button", data: {"bs-toggle": "dropdown"}, aria: {expanded: "false"}}
              %i.fa.fa-user.padding-right-small
              = current_user.name
              %i.fa.fa-caret-down
            %ul.dropdown-menu.dropdown-menu-end
              %li= link_to "My Account", user_path(current_user), class: "dropdown-item"
              %li= link_to "Logout", logout_path, class: "dropdown-item"

- if current_user
  .sidebar-nav
    %ul
      %li.d-sm-none
        %a.nav-header.collapsed{data: {"bs-target": ".user-menu", "bs-toggle": "collapse"}}
          %i.fa.fa-fw.fa-user
          =current_user.first_name
          %i.fa.fa-collapse
      %li.d-sm-none
        %ul.user-menu.nav.nav-list.collapse
          %li
            = link_to user_path(current_user) do
              %span.fa.fa-fw.fa-caret-right
              My Account
          %li
            = link_to logout_path do
              %span.fa.fa-fw.fa-caret-right
              Log Out

      %li
        = link_to index_path, class: "nav-header" do
          %i.fa.fa-fw.fa-house
          Dashboard

      - unless current_user.volunteer?
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".dashboard-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-gauge-high
            Admin
            %i.fa.fa-collapse

        %li
          %ul.dashboard-menu.nav.nav-list.collapse
            - if can? :manage, Category
              %li
                = link_to categories_path do
                  %span.fa.fa-fw.fa-file-medical
                  Categories
            - if can? :manage, Item
              %li
                = link_to items_path do
                  %span.fa.fa-fw.fa-stethoscope
                  Items
            - if can? :manage, Warehouse
              %li
                = link_to warehouses_path do
                  %span.fa.fa-fw.fa-warehouse
                  Warehouses
            - if can? :manage, Hospital
              %li
                = link_to hospitals_path do
                  %span.fa.fa-fw.fa-hospital
                  Hospitals, Facilities & Clinics
            - if can? :manage, User
              %li
                = link_to users_path do
                  %span.fa.fa-fw.fa-users
                  Users

      - if can? :manage, Item
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".reconcile-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-down-left-and-up-right-to-center
            Reconciliation
            %i.fa.fa-collapse
        %li
          %ul.reconcile-menu.nav.nav-list.collapse
            %li
              = link_to reconcile_unverified_path do
                %span.fa.fa-fw.fa-star
                Unverified Items
            %li
              = link_to reconcile_uncategorized_path do
                %span.fa.fa-fw.fa-file-medical
                Uncategorized
            %li
              = link_to reconcile_flagged_path do
                %span.fa.fa-fw.fa-flag
                User-flagged

      - if can? :read, Shipment
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".shipments-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-ship
            Shipments
            %i.fa.fa-collapse
        %li
          %ul.shipments-menu.nav.nav-list.collapse
            %li
              = link_to shipments_path do
                %span.fa.fa-fw.fa-table-list
                List
            - if can? :create, Shipment
              %li
                = link_to new_shipment_path do
                  %span.fa.fa-fw.fa-star
                  New

      - if can? :read, Container
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".containers-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-truck
            Containers
            %i.fa.fa-collapse
        %li
          %ul.containers-menu.nav.nav-list.collapse
            %li
              = link_to containers_path do
                %span.fa.fa-fw.fa-table-list
                List
            - if can? :create, Container
              %li
                = link_to new_container_path do
                  %span.fa.fa-fw.fa-star
                  New

      %li
        %a.nav-header.collapsed{data: {"bs-target": ".pallets-menu", "bs-toggle": "collapse"}}
          %i.fa.fa-fw.fa-pallet
          Pallets
          %i.fa.fa-collapse
      %li
        %ul.pallets-menu.nav.nav-list.collapse
          %li
            = link_to pallets_path do
              %span.fa.fa-fw.fa-table-list
              All
          %li
            = link_to pallets_path(display: :in_progress) do
              %span.fa.fa-fw.fa-list
              In Progress
          - if can? :create, Pallet
            %li
              = link_to new_pallet_path do
                %span.fa.fa-fw.fa-star
                New

      %li
        %a.nav-header.collapsed{data: {"bs-target": ".box-menu", "bs-toggle": "collapse"}}
          %i.fa.fa-fw.fa-box-open
          Boxes
          %i.fa.fa-collapse
      %li
        %ul.box-menu.nav.nav-list.collapse
          %li
            = link_to boxes_path do
              %span.fa.fa-fw.fa-table-list
              All
          %li
            = link_to boxes_path(display: :in_progress) do
              %span.fa.fa-fw.fa-list
              In Progress
          - if can? :create, Box
            %li
              = link_to new_box_path do
                %span.fa.fa-fw.fa-star
                New

      - unless current_user.receiving_manager?
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".staging-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-truck-ramp-box
            Staging Area
            %i.fa.fa-collapse
        %li
          %ul.staging-menu.nav.nav-list.collapse
            %li
              = link_to pallets_path(display: :staged) do
                %span.fa.fa-fw.fa-pallet
                Pallets

            %li
              = link_to boxes_path(display: :staged) do
                %span.fa.fa-fw.fa-box-open
                Boxes

            %li
              = link_to staged_items_path do
                %span.fa.fa-fw.fa-stethoscope
                Items
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".warehouse-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-clipboard-list
            Warehouse Area
            %i.fa.fa-collapse
        %li
          %ul.warehouse-menu.nav.nav-list.collapse
            %li
              = link_to pallets_path(display: :warehoused) do
                %span.fa.fa-fw.fa-pallet
                Pallets

            %li
              = link_to boxes_path(display: :warehoused) do
                %span.fa.fa-fw.fa-box-open
                Boxes

            %li
              = link_to warehoused_items_path do
                %span.fa.fa-fw.fa-stethoscope
                Items
      - if current_user.receiving_manager? || current_user.masquerader
        %li
          %a.nav-header.collapsed{data: {"bs-target": ".all-items-menu", "bs-toggle": "collapse"}}
            %i.fa.fa-fw.fa-stethoscope
            Unpack Items
            %i.fa.fa-collapse
        %li
          %ul.all-items-menu.nav.nav-list.collapse
            %li
              = link_to all_received_items_path do
                %span.fa.fa-fw.fa-table-list
                List All
            %li
              = link_to received_categories_path do
                %span.fa.fa-fw.fa-file-medical
                Browse by Category
            %li
              = link_to unpacking_events_path do
                %span.fa.fa-fw.fa-clock-rotate-left
                Unpacking History

      %li
        = link_to my_activity_path, class: "nav-header" do
          %i.fa.fa-fw.fa-clock-rotate-left
          My Activity

      %li
        %a.nav-header.collapsed{data: {"bs-target": ".about-menu", "bs-toggle": "collapse"}}
          %i.fa.fa-fw.fa-info
          About
          %i.fa.fa-collapse
      %li
        %ul.about-menu.nav.nav-list.collapse
          %li
            = link_to dev_updates_path do
              %span.fa.fa-fw.fa-code
              Developer Updates
          - if current_user.admin? || current_user.shipping_manager?
            %li
              = link_to admin_help_path do
                %span.fa.fa-fw.fa-question
                Help
          - elsif current_user.volunteer?
            %li
              = link_to volunteer_help_path do
                %span.fa.fa-fw.fa-question
                Help
          - else
            %li.disabled
              %a
                %span.fa.fa-fw.fa-question
                Receiving Help (Coming Soon)
          %li.d-sm-none
            = link_to "mailto:jesse@kbnf.org?subject=I%20Found%20a%20Bug%21&body=Please%20reply%20with%20your%20browser%2C%20URL%20and%20name%2E", {target: "_blank",rel: "noopener noreferrer" } do
              %span.fa.fa-fw.fa-bug
              Report a Bug
          %li
            = link_to privacy_path do
              %span.fa.fa-fw.fa-user-shield
              Privacy
          %li
            = link_to terms_path do
              %span.fa.fa-fw.fa-scale-balanced
              Terms
          %li.disabled
            %a
              %span.fa.fa-fw.fa-info
              Version #303
