-# Used by Admins and Shipping Managers on someone else's profile. People change
-# their own password on the Change Password page (passwords/edit).
%button.btn.btn-primary{data: {"bs-target": "#change-password-modal", "bs-toggle": "modal"}}
  %i.fa.fa-user-shield
  %span Set Temporary Password
.modal.fade{id: "change-password-modal", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#assignmentModalLabel Set Temporary Password
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#assignmentModalBody
        .row.edit-modal-body
          = form_for @user, url: change_password_user_path do |f|
            .row
              .col-12
                %p
                  #{@user.first_name} will have to choose their own password the next time they log in.
                .form-group
                  %label Temporary Password
                  = f.password_field :password, class: "form-control", autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH
                  %small.text-muted At least #{User::MIN_PASSWORD_LENGTH} characters.
                .form-group
                  %label Confirm Temporary Password
                  = f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH

              .col-12
                .btn-toolbar.list-toolbar
                  = submit_button_responsive("Save")
