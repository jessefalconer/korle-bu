.modal.fade{id: "add-hospital-modal"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title Add a Hospital/Facility/Clinic
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top
        .row
          .col-12
            = render partial: "hospitals/form", locals: {redirect: redirect}
