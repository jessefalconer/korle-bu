.modal.fade{id: "item-#{item.id}Modal", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title Edit #{item.generated_name}
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top
        = render partial: "items/form", locals: {submit_path: "reconcile", item: item, redirect: redirect}
