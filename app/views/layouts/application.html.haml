!!!
%html
  %head
    %meta{charset: "UTF-8"}
    %meta{:content => "IE=edge,chrome=1", "http-equiv" => "X-UA-Compatible"}
    %meta{:content => "width=device-width, initial-scale=1.0, viewport-fit=cover", :name => "viewport"}
    %meta{:content => "#007096", :name => "theme-color"}
    %title KBNF | Inventory
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "jquery-ui.min", "application", media: "all"
    = favicon_link_tag "/kbnf-favicon-32x32.png", skip_pipeline: true
    -# Plain (non-module) scripts the app code relies on as globals; they run in order,
    -# before the importmap modules below
    = javascript_include_tag "jquery.min", "bootstrap.min", "jquery-ui.min"
    = javascript_importmap_tags
  %body.theme-1
    = render "layouts/header"

    = yield

    = render "layouts/footer"
