%button.btn.btn-primary{data: {"bs-target": "#export-modal", "bs-toggle": "modal"}}
  %span Export
  %i.fa.fa-file-export
.modal.fade{id: "export-modal", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#assignmentModalLabel Export #{@shipment.name}
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#assignmentModalBody
        .row.edit-modal-body
          .col-12
            = form_for ShipmentExport.new(@shipment.id), url: shipment_exports_path do |f|
              %h5 Select a grouping strategy:
              %label.radio-option
                = f.radio_button :group_by, "category", checked: true
                By Item Category
              %label.radio-option
                = f.radio_button :group_by, "item"
                By Item
              = f.hidden_field :id, value: @shipment.id
              = submit_export
