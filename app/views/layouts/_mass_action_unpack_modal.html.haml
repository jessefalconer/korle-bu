= render partial: "layouts/add_hospital_modal", locals: {redirect: request.referrer}
%button.btn.btn-primary.responsive-button{data: {"bs-target": "#unpack-all", "bs-toggle": "modal"}, disabled: true}
  %i.fa.fa-truck-ramp-box
  %span.main-text Unpack All
  %span.mass-action-count
.modal.fade{id: "unpack-all", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#unpackModalLabel Unpack all selected items.
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#unpackModalBody
        .row.mass-action-form
          .col-12
            %h5 Send item(s) to the selected hospital/facility/clinic:

          = form_with url: received_categories_unpack_selected_path, method: :post, id: "mass_action" do |f|
            .row
              .col-12
                .form-group
                  %label Hospital/Facility/Clinic
                  = select_tag("hospital_id", hospital_options, { include_blank: true, class: "form-select" })
                .form-group
                  %label Unpacked On
                  = date_field_tag :timestamp, unpack_date, class: "form-control"
                .form-group
                  %label Notes
                  = text_field_tag :notes, nil, placeholder: "Explanation", class: "form-control"
                %h6
                  %a{href: "#", data: {"switch-modal": "#add-hospital-modal"}} Don't see your hospital/facility/clinic? Add one.
              .col-12
                = submit_button_responsive("Update", "float-end")
