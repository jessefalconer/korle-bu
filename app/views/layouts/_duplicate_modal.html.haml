%button.btn.btn-primary.responsive-button{data: {"bs-target": "#duplicate-modal", "bs-toggle": "modal"}}
  %i.fa.fa-eye-dropper
  %span.main-text Duplicate
  %span.mass-action-count
.modal.fade{id: "duplicate-modal", tabindex: "-1", "aria-hidden": "true"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#assignmentModalLabel Duplicate #{@box.name}
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#assignmentModalBody
        = form_for @box, url: box_duplicate_path(@box), method: :get do |f|
          .row.mass-action-form
            .col-12
              %h5
                Newly duplicated box names will continue to be unique.
            .col-12
              %h5
                Duplication Count
              .form-group
                = number_field_tag :duplication_count, 1, { min: 1, class: "form-control" }
            .col-12
              %h5
                Duplication Strategy
              %label.radio-option
                = radio_button_tag :strategy, "deep", true
                Everything
              %label.radio-option
                = radio_button_tag :strategy, "shallow", false, { disabled: @box.pallet.nil? && @box.container.nil? }
                Everything Except Pallet and/or Container Assignments
            .col-12
              = submit_button_responsive("Duplicate", "float-end")
