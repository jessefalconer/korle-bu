= render partial: "layouts/add_hospital_modal", locals: {redirect: box_box_items_path(@box)}
%button.btn.btn-primary.responsive-button{data: {"bs-target": "#unpack-all", "bs-toggle": "modal"}}
  %i.fa.fa-truck-loading
  %span.main-text Unpack All
.modal.fade{id: "unpack-all"}
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title#unpackModalLabel Unpack all items in #{@box.name}.
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
      .modal-body.margin-top#unpackModalBody
        .row.mass-action-form
          - unless @box.received?
            .col-12
              %i.fas.fa-exclamation-triangle.text-warning
              This box has not been received. Check its status.
          .col-12
            %h5 Send #{@box.box_items.size} item(s) to the selected hospital/facility/clinic:

          = form_for @box, url: boxes_unpack_all_path(@box), method: :post do |f|
            .col-12
              .form-group
                %label Hospital/Facility/Clinic
                = select_tag("hospital_id", hospital_options, { include_blank: true, class: "form-select" })
              .form-group
                %label Unpacked On
                - today = DateTime.current.in_time_zone("Pacific Time (US & Canada)").strftime("%Y-%m-%d")
                = text_field_tag :timestamp, today, placeholder: "YYYY-MM-DD", class: "form-control datepickers"
              .form-group
                %label Notes
                = text_field_tag :notes, nil, placeholder: "Explanation", class: "form-control"
              %h6
                %a{data: {"bs-target": "#add-hospital-modal", "bs-toggle": "modal"}, href: "", "data-bs-dismiss" => "modal"} Don't see your hospital/facility/clinic? Add one.
            .col-12
              = submit_button_responsive("Update", "float-end")
