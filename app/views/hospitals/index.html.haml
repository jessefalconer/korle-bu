.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Hospitals, Facilities & Clinics
    = render partial: "layouts/jump_to_modal"
    = add_button(new_hospital_path, "Hospital/Facility/Clinic")
  .main-content
    %table.table.table-striped.table-hover.link-rows
      %thead
        %tr
          %th Name
          %th Warehouse
          %th Country
          %th.d-none.d-sm-table-cell Status
      %tbody
        - @hospitals.each do |hospital|
          %tr
            %td
              = link_to hospital_path(hospital) do
                %p= hospital.name
            %td
              = link_to hospital_path(hospital) do
                %p= hospital.warehouse&.name
            %td
              = link_to hospital_path(hospital) do
                %p= hospital.country
            %td.d-none.d-sm-table-cell
              = link_to hospital_path(hospital) do
                = status_label(hospital.status, color_class: hospital.active? ? "text-success" : "text-danger")

    = paginate @hospitals
