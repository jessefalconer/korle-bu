.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to index_path do
          Home
      %li.breadcrumb-item.active My Activity (30 Days)
    = render partial: "layouts/jump_to_modal"
  .main-content
    .row
      .col-12
        - if @boxes.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#boxes"}
              %i.fa.fa-box-open
              Boxes
              %span.badge.text-bg-info= @boxes.size
            .collapse{id: "boxes"}
              %table.table.table-striped
                %thead
                  %tr
                    %th Custom ID
                    %th Name
                    %th Created At
                    %th.d-none.d-sm-table-cell Status
                    %th.d-none.d-sm-table-cell Boxed Items
                %tbody
                  - @boxes.each do |box|
                    %tr
                      %td
                        %p= box.custom_uid
                      %td
                        = link_to box_path(box) do
                          %p= box.name
                      %td
                        %p= box.created_at.strftime("%Y-%m-%d")
                      %td.d-none.d-sm-table-cell
                        %p= box.status
                      %td.d-none.d-sm-table-cell
                        %p= box.box_items.size

        - if @pallets.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#pallets"}
              %i.fa.fa-pallet
              Pallets
              %span.badge.text-bg-info= @pallets.size
            .collapse{id: "pallets"}
              %table.table.table-striped
                %thead
                  %tr
                    %th Custom ID
                    %th Name
                    %th Created At
                    %th.d-none.d-sm-table-cell Status
                    %th.d-none.d-sm-table-cell Palletized Items
                %tbody
                  - @pallets.each do |pallet|
                    %tr
                      %td
                        %p= pallet.custom_uid
                      %td
                        = link_to pallet_path(pallet) do
                          %p= pallet.name
                      %td
                        %p= pallet.created_at.strftime("%Y-%m-%d")
                      %td.d-none.d-sm-table-cell
                        %p= pallet.status
                      %td.d-none.d-sm-table-cell
                        %p= pallet.pallet_items.size

        - if @containers.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#containers"}
              %i.fa.fa-truck
              Containers
              %span.badge.text-bg-info= @containers.size
            .collapse{id: "containers"}
              %table.table.table-striped
                %thead
                  %tr
                    %th Custom ID
                    %th Name
                    %th Created At
                    %th.d-none.d-sm-table-cell Status
                    %th.d-none.d-sm-table-cell Containerized Items
                %tbody
                  - @containers.each do |container|
                    %tr
                      %td
                        %p= container.custom_uid
                      %td
                        = link_to container_path(container) do
                          %p= container.name
                      %td
                        %p= container.created_at.strftime("%Y-%m-%d")
                      %td.d-none.d-sm-table-cell
                        %p= container.status
                      %td.d-none.d-sm-table-cell
                        %p= container.container_items.size

        - if @staged_items.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#staged_items"}
              %i.fa.fa-stethoscope
              Staged Items
              %span.badge.text-bg-info= @staged_items.size
            .collapse{id: "staged_items"}
              %table.table.table-striped
                %tbody
                  %thead
                    %tr
                      %th.d-none.d-sm-table-cell Quantity
                      %th Name
                      %th.d-none.d-sm-table-cell
                      %th Staging
                      %th Date
                  - @staged_items.each do |item|
                    %tr
                      %td.d-none.d-sm-table-cell
                        %p= item.quantity
                      %td
                        = link_to item_path(item.item_id) do
                          = item.generated_name
                      %td.text-center.d-none.d-sm-table-cell
                        %i.fa.fa-arrow-right
                      %td
                        = link_to staged_items_path do
                          Staging Area
                      %td
                        %p= item.created_at.strftime("%Y-%m-%d")

        - if @warehoused_items.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#warehoused_items"}
              %i.fa.fa-stethoscope
              Warehoused Items
              %span.badge.text-bg-info= @warehoused_items.size
            .collapse{id: "warehoused_items"}
              %table.table.table-striped
                %tbody
                  %thead
                    %tr
                      %th.d-none.d-sm-table-cell Quantity
                      %th Name
                      %th.d-none.d-sm-table-cell
                      %th Staging
                      %th Date
                  - @warehoused_items.each do |item|
                    %tr
                      %td.d-none.d-sm-table-cell
                        %p= item.quantity
                      %td
                        = link_to item_path(item.item_id) do
                          = item.generated_name
                      %td.text-center.d-none.d-sm-table-cell
                        %i.fa.fa-arrow-right
                      %td
                        = link_to warehoused_items_path do
                          Warehouse Area
                      %td
                        %p= item.created_at.strftime("%Y-%m-%d")

        - if @box_items.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#box_items"}
              %i.fa.fa-stethoscope
              Boxed Items
              %span.badge.text-bg-info= @box_items.size
            .collapse{id: "box_items"}
              %table.table.table-striped
                %tbody
                  %thead
                    %tr
                      %th.d-none.d-sm-table-cell Quantity
                      %th Name
                      %th.d-none.d-sm-table-cell
                      %th Box
                      %th Date
                  - @box_items.each do |item|
                    %tr
                      %td.d-none.d-sm-table-cell
                        %p= item.quantity
                      %td
                        = link_to item_path(item.item_id) do
                          = item.generated_name
                      %td.text-center.d-none.d-sm-table-cell
                        %i.fa.fa-arrow-right
                      %td
                        = link_to box_path(item.box) do
                          = item.box.name
                      %td
                        %p= item.created_at.strftime("%Y-%m-%d")

        - if @pallet_items.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#pallet_items"}
              %i.fa.fa-stethoscope
              Palletized Items
              %span.badge.text-bg-info= @pallet_items.size
            .collapse{id: "pallet_items"}
              %table.table.table-striped
                %tbody
                  %thead
                    %tr
                      %th.d-none.d-sm-table-cell Quantity
                      %th Name
                      %th.d-none.d-sm-table-cell
                      %th Pallet
                      %th Date
                  - @pallet_items.each do |item|
                    %tr
                      %td.d-none.d-sm-table-cell
                        %p= item.quantity
                      %td
                        = link_to item_path(item.item_id) do
                          = item.generated_name
                      %td.text-center.d-none.d-sm-table-cell
                        %i.fa.fa-arrow-right
                      %td
                        = link_to pallet_path(item.pallet) do
                          = item.pallet.name
                      %td
                        %p= item.created_at.strftime("%Y-%m-%d")

        - if @container_items.any?
          .card
            %a.card-header.collapsed{data: {"bs-toggle": "collapse"}, href: "#container_items"}
              %i.fa.fa-stethoscope
              Containerized Items
              %span.badge.text-bg-info= @container_items.size
            .collapse{id: "container_items"}
              %table.table.table-striped
                %tbody
                  %thead
                    %tr
                      %th.d-none.d-sm-table-cell Quantity
                      %th Name
                      %th.d-none.d-sm-table-cell
                      %th Container
                      %th Date
                  - @container_items.each do |item|
                    %tr
                      %td.d-none.d-sm-table-cell
                        %p= item.quantity
                      %td
                        = link_to item_path(item.item_id) do
                          = item.generated_name
                      %td.text-center.d-none.d-sm-table-cell
                        %i.fa.fa-arrow-right
                      %td
                        = link_to container_path(item.container) do
                          = item.container.name
                      %td
                        %p= item.created_at.strftime("%Y-%m-%d")

        - if @boxes.none? && @pallets.none? && @containers.none? && @box_items.none? && @pallet_items.none? && @container_items.none?
          %h4.text-center
            No history
            %i.fa.fa-fw.fa-clock-rotate-left
            to display.
