- stats = @stats
- packer = !current_user.receiving_manager?
.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to index_path do
          Home
      %li.breadcrumb-item.active Dashboard
    = render partial: "layouts/jump_to_modal"
  .main-content
    .dashboard-toolbar
      %p.fact-of-the-day
        %i.fa.fa-lightbulb{"aria-hidden": "true"}
        = stats.fact_of_the_day
      .btn-group.range-toggle{role: "group", "aria-label": "Time range"}
        - DashboardStats::RANGES.each do |range, label|
          = link_to label, index_path(range: range),
            class: "btn btn-sm #{range == stats.range ? "btn-primary" : "btn-outline-secondary"}",
            "aria-current": (range == stats.range ? "true" : nil)
    - if packer
      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#page-stats"} Packing Activity (#{stats.period_name.capitalize})
        .card-body.collapse.show#page-stats
          .stat-grid
            - stats.tiles.each do |tile|
              = render "stat_tile", label: tile.label, value: tile.value, tile: tile, compare: stats.previous_period_name
          .row.dashboard-charts
            .col-lg-8
              = render "weekly_chart", series: stats.weekly_packed, title: "Items packed per week", value_label: "Items packed"
            .col-lg-4
              %h5.chart-title Top categories packed
              %p.chart-subtitle Units, #{stats.period_name}
              = render "bar_list", stacked: true, rows: stats.top_categories.map { |name, units| { label: name, value: units } },
                empty: "Nothing packed in this period yet."
          .weight-banner
            %i.fa.fa-weight-hanging{"aria-hidden": "true"}
            %span
              %strong #{number_with_delimiter(stats.weight_this_year)} kg
              packed so far this year: about the weight of
              %strong #{stats.e30_m3_this_year} #{"1988 BMW M3".pluralize(stats.e30_m3_this_year == 1 ? 1 : 2)}.

    - if packer && can?(:read, Shipment)
      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#pipeline-stats"} Shipments & Data Quality
        .card-body.collapse.show#pipeline-stats
          %h5.chart-title Shipment pipeline
          %ol.pipeline
            - stats.pipeline.each do |stage|
              %li.pipeline-stage
                .stat-label= stage[:status]
                .stat-value
                  = number_with_delimiter(stage[:shipments])
                  %span.stat-unit= "shipment".pluralize(stage[:shipments])
                .stat-compare
                  #{number_with_delimiter(stage[:units])} units · #{number_with_delimiter(stage[:weight])} kg
          - quality = stats.data_quality
          %h5.chart-title Item catalogue quality
          - [["Verified", quality[:verified]], ["Categorized", quality[:categorized]]].each do |label, done|
            - share = quality[:total].zero? ? 0 : (done * 100.0 / quality[:total])
            .meter-row
              .meter-label
                = label
                %span.text-muted #{number_with_delimiter(done)} of #{number_with_delimiter(quality[:total])}
              .meter{role: "meter", "aria-valuenow": share.round, "aria-valuemin": 0, "aria-valuemax": 100, "aria-label": "#{label} items"}
                .meter-fill{style: "width: #{share.round(1)}%"}
              .meter-value #{share.floor}%

    - if @overview
      = render "unpacking_card", unpacking: stats.unpacking(everywhere: true), stats: stats, title: "Unpacking & Destinations"

    - if current_user.receiving_manager?
      - receiving = stats.receiving
      - received = receiving.received_tiles
      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#available-stats"} Inventory at #{current_user.warehouse&.name || "Your Warehouse"}
        .card-body.collapse.show#available-stats
          .stat-grid
            = render "stat_tile", label: "Units in stock", value: received[:remaining]
            = render "stat_tile", label: "Different items in stock", value: received[:distinct_items]
            = render "stat_tile", label: "Stock lines", value: received[:lines], note: "Items in boxes, pallets and containers"
            = render "stat_tile", label: "Weight in stock", value: "≈ #{number_with_delimiter(received[:weight])} kg", note: "Estimated from shipped weight"
            = render "stat_tile", label: "Next expiry", value: received[:earliest_expiry]&.strftime("%Y-%m-%d") || "None upcoming",
              note: (received[:expired].positive? ? "#{number_with_delimiter(received[:expired])} lines already expired" : "Nothing expired")
          .row.dashboard-charts
            .col-lg-6
              %h5.chart-title Stock by category
              %p.chart-subtitle Units still to unpack
              = render "bar_list", stacked: true, rows: receiving.stock_by_category.map { |name, units| { label: name, value: units } },
                empty: "No received stock right now."
            .col-lg-6
              %h5.chart-title
                %i.fa.fa-hourglass-half{"aria-hidden": "true"}
                Expiring in the next 90 days
                %span.badge.text-bg-warning= receiving.expiring_soon_count
              - expiring = receiving.expiring_soon
              - if expiring.any?
                %table.table.list
                  %tbody
                    - expiring.each do |pi|
                      %tr
                        %td
                          = link_to present(pi).path do
                            %p.title= pi.generated_name
                          %p.info= pi.location_name
                        %td
                          %p Expires #{pi.expiry_date.strftime("%Y-%m-%d")}
                          %p.info #{number_with_delimiter(pi.remaining_quantity)} left
              - else
                %p.empty-state Nothing expires in the next 90 days.
          - stale_count = receiving.stale_stock.count
          %p.stale-note
            %i.fa.fa-clock-rotate-left{"aria-hidden": "true"}
            #{number_with_delimiter(stale_count)} stock #{"line".pluralize(stale_count)} untouched for 60+ days.
            = link_to "See all received items", all_received_items_path
      = render "unpacking_card", unpacking: stats.unpacking, stats: stats,
        title: "Unpacking at #{current_user.warehouse&.name || "Your Warehouse"}"

    - if packer
      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#user-stats"} My Stats (All-time)
        .card-body.collapse.show#user-stats
          .stat-grid
            - stats.my_totals.each do |label, value|
              = render "stat_tile", label: label, value: value
          - milestones = stats.milestones
          .milestones
            %h5.chart-title Packing milestones
            %ul.milestone-badges
              - DashboardStats::MILESTONES.each do |milestone|
                - reached = milestones[:reached].include?(milestone)
                %li.milestone{class: (reached ? "is-reached" : "is-locked")}
                  %i.fa{class: reached ? "fa-medal" : "fa-lock", "aria-hidden": "true"}
                  = number_with_delimiter(milestone)
                  %span.visually-hidden= reached ? "reached" : "not reached yet"
            - if milestones[:next]
              - to_go = milestones[:next] - milestones[:count]
              %p.chart-subtitle
                You've packed #{number_with_delimiter(milestones[:count])} items.
                #{number_with_delimiter(to_go)} more to reach #{number_with_delimiter(milestones[:next])}!
            - else
              %p.chart-subtitle You've packed #{number_with_delimiter(milestones[:count])} items. Every milestone reached!

      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#leaderboard-stats"} Leaderboard (#{stats.period_name.capitalize})
        .card-body.collapse.show#leaderboard-stats
          .row
            - stats.leaderboards.each do |board|
              .col-md-6.leaderboard
                %h5.chart-title
                  %i.fa.fa-crown.text-warning{"aria-hidden": "true"}
                  = board.title
                %p.chart-subtitle= board.subtitle
                - top = board.rows.first(DashboardStats::LEADERBOARD_SIZE)
                = render "bar_list", ordered: true, empty: "No one yet. This could be you!",
                  rows: top.map { |row| { label: row.name, value: row.value, you: row.user_id == current_user.id } }
                - mine = stats.rank_on(board)
                - if mine && mine[:rank] > DashboardStats::LEADERBOARD_SIZE
                  %p.your-rank You're ##{mine[:rank]} of #{mine[:of]} with #{number_with_delimiter(mine[:value])}.
          .highlight-grid
            - [["Do You Even Lift?", "Heaviest packed item", stats.heaviest_item],
               ["Bulk Discount", "Greatest single packed quantity", stats.biggest_quantity]].each do |title, caption, pick|
              .highlight
                %h5.chart-title= title
                - if pick
                  .highlight-name
                    = pick[:name]
                    %i.fa.fa-crown.text-warning{"aria-hidden": "true"}
                  .highlight-value= pick[:value]
                  .highlight-item= pick[:item]
                - else
                  .highlight-name No one (yet!)
                %p.chart-subtitle= caption
            .highlight
              %h5.chart-title Your Streak
              - streak = stats.streak
              .highlight-name
                %i.fa.fa-fire{"aria-hidden": "true", class: ("is-lit" if streak.positive?)}
                #{streak} #{"week".pluralize(streak)}
              %p.chart-subtitle
                = streak.positive? ? "In a row with at least one packed item. Keep it going!" : "Pack an item this week to start a streak."

    .card
      %a.card-header{data: {"bs-toggle": "collapse"}, href: "#fun-stats"} Just For Fun
      .card-body.collapse.show#fun-stats
        .highlight-grid
          .highlight
            %h5.chart-title
              %i.fa.fa-star.text-warning{"aria-hidden": "true"}
              Item of the Day
            - item_of_the_day = stats.item_of_the_day
            - if item_of_the_day
              .highlight-item= link_to item_of_the_day.last, item_path(item_of_the_day.first)
            - else
              .highlight-item Check back tomorrow.
          .highlight
            %h5.chart-title
              %i.fa.fa-dice{"aria-hidden": "true"}
              Longest Name, #{stats.period_name.capitalize}
            .highlight-item= stats.longest_name || "No new items yet."
          .highlight
            %h5.chart-title
              %i.fa.fa-hand-sparkles{"aria-hidden": "true"}
              Say Hello
            - if stats.newcomers.any?
              .highlight-item Welcome, #{stats.newcomers.to_sentence}!
              %p.chart-subtitle New this fortnight
            - else
              .highlight-item No new faces this fortnight.

    - if @overview
      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#new-users"}
          Recently Added Users
          %span.badge.text-bg-info Total: #{User.count}
        .collapse.show#new-users
          %table.table.table-striped.table-hover.link-rows
            %thead
              %tr
                %th.d-none.d-sm-table-cell Name
                %th Email
                %th.d-none.d-sm-table-cell Role
                %th Status
            %tbody
              - @recent_users.each do |user|
                %tr
                  %td.d-none.d-sm-table-cell
                    = link_to user_path(user) do
                      %p= user.name
                  %td
                    = link_to user_path(user) do
                      %p= user.email
                  %td.d-none.d-sm-table-cell
                    = link_to user_path(user) do
                      %p= user.role
                  %td
                    = link_to user_path(user) do
                      - if user.active?
                        = status_label(user.status, color_class: "text-success")
                      - else
                        = status_label(user.status, color_class: "text-danger")

      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#new-items"}
          Recently Added Items
          %span.badge.text-bg-info Total: #{Item.count}
        .collapse.show#new-items
          %table.table.list
            %tbody
              - @recent_items.each do |item|
                %tr
                  %td
                    = link_to item_path(item) do
                      %p.title= item.generated_name
                    %p.info= item.category&.name
                  %td.d-none.d-sm-table-cell
                    %p= item.created_at.strftime("%Y-%m-%d")
                    = link_to user_path(item.user) do
                      = item.user.name
                  %td
                    %p Instances:
                    = link_to item_instances_path(item) do
                      %p= @recent_item_instance_counts.fetch(item.id, 0)

      .card
        %a.card-header{data: {"bs-toggle": "collapse"}, href: "#unpacked-items"}
          Recently Unpacked Items
          %span.badge.text-bg-info Total: #{UnpackingEvent.count}
        .collapse.show#unpacked-items
          %table.table.list
            %tbody
              - @recent_unpacking_events.each do |event|
                %tr
                  %td
                    = link_to item_path(event.item) do
                      %p.title= event.generated_name
                    %p.info Sent to: #{event.hospital&.name}
                  %td.d-none.d-sm-table-cell
                    %p= event.created_at.strftime("%Y-%m-%d")
                    = link_to user_path(event.user) do
                      = event.user.name
                  %td
                    %p Quantity:
                    = link_to present(event.packed_item).path do
                      %p= event.quantity

    .card
      %a.card-header{data: {"bs-toggle": "collapse"}, href: "#notes"} Personal Notes
      .card-body.collapse.show#notes
        - if current_user.notes.blank?
          %p
            Write something down by visiting your
            = link_to user_path(current_user) do
              user profile.
        - else
          %p= simple_format(current_user.notes)
