.col-12
  .dialog
    %img{src: "/kbnf-logo.png", alt: "Korle-Bu Neuroscience Foundation", class: "kbnf-logo-center"}
    .card
      %p.card-header.no-collapse Sign In
      .card-body
        = form_tag login_path do
          .form-group
            %label Email
            = text_field_tag :email, "", class: "form-control span12"
          .form-group
            %label Password
            = text_field_tag :password, "", class: "form-control span12", type: "password"
          .form-group
            = submit_button("Sign In", "", "fa-user")
          .clearfix
      %p.card-header.no-collapse
        Need an account? Ask a KBNF administrator.
