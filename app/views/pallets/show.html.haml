.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      = present(@pallet).breadcrumbs
    = render partial: "layouts/jump_to_modal"
    - if can? :manage, Pallet
      = render partial: "layouts/edit_modal"
    - if can? :read, PackedItem
      = manage_button(pallet_pallet_items_path(@pallet), "Items")
    - if can? :manage, PackedItem
      = render partial: "layouts/mass_action_modal", locals: {name: @pallet.name, redirect: pallet_path(@pallet), record: @pallet}
    - if current_user.admin? || current_user.receiving_manager?
      = render partial: "layouts/pallets_unpack_all_modal"
    - if can? :destroy, @pallet
      = delete_button(pallet_path(@pallet), "Are you sure you want to delete #{@pallet.name}? This cannot be reversed")

  .main-content
    .row.detail-layout
      .col-md-5
        .row.detail-card
          .col-12
            %h5.text-muted Name
            %h4= @pallet.name
          - if @pallet.notes.present?
            .col-12
              %h6.text-muted Notes
              %h5= @pallet.notes
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Custom ID
            %h5= @pallet.custom_uid
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Status
            = status_label(@pallet.status, :h5)
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Weight (kg)
            %h5= @pallet.weight.to_f.round(4) || "N/A"
          - if @pallet.category
            .col-6.col-sm-4.col-md-6
              %h6.text-muted Category
              %h5= @pallet.category.name
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created By
            %h5= @pallet.user.name
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created At
            %h5= @pallet.created_at.strftime("%Y-%m-%d")

      .col-md-7
        - present(@pallet) do |pallet|
          .card
            %a.card-header{data: {"bs-toggle": "collapse"}, href: "#location"}
              %i.fa.fa-location-dot
              Location Details
            .collapse.show#location
              %table.table.list
                %tbody
                  %tr
                    %td
                      %p Warehouse
                    = pallet.warehouse_location
                  %tr
                    %td
                      %p Shipment
                    = pallet.shipment_location
                  %tr
                    %td
                      %p Container
                    = pallet.container_location

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#boxes"}
            %i.fa.fa-box-open
            Boxes on this Pallet
            %span.badge{class: @pallet.boxes.any? ? "text-bg-success" : "text-bg-warning"}= @pallet.boxes.size

          - if @pallet.boxes.any?
            .collapse#boxes
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "boxes"}
              = render partial: "boxes/micro_table", locals: {boxes: @pallet.boxes, table_id: "filter-boxes-table"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#boxes"}
                %span Close
          - else
            .collapse.card-body#boxes
              %h5.text-center
                No boxes
                %i.fa.fa-box-open
                assigned to this pallet
                %i.fa.fa-pallet

        .card
          %a.card-header.collapsed{class: (@pallet.pallet_items.size > 5 && "collapsed"), data: {"bs-toggle": "collapse"}, href: "#packed-items"}
            %i.fa.fa-stethoscope
            Palletized Items
            %span.badge{class: @pallet.pallet_items.any? ? "text-bg-success" : "text-bg-warning"}= @pallet.pallet_items.size

          - if @pallet.pallet_items.any?
            .collapse#packed-items{class: (@pallet.pallet_items.size < 6 && "show")}
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "packed-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @pallet.pallet_items, assoc: "packed-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#packed-items"}
                %span Close
          - else
            .collapse.card-body#packed-items
              %h5.text-center
                No packed items
                %i.fa.fa-stethoscope
                on this pallet
                %i.fa.fa-pallet

        .card
          %a.card-header.collapsed{class: (@pallet.box_items.size > 5 && "collapsed"), data: {"bs-toggle": "collapse"}, href: "#boxed-items"}
            %i.fa.fa-stethoscope
            Packed Items in Boxes
            %span.badge{class: @pallet.box_items.any? ? "text-bg-success" : "text-bg-warning"}= @pallet.box_items.size

          - if @pallet.box_items.any?
            .collapse#boxed-items{class: (@pallet.box_items.size < 6 && "show")}
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "boxed-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @pallet.box_items, assoc: "boxed-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#boxed-items"}
                %span Close
          - else
            .collapse.card-body#boxed-items
              %h5.text-center
                No packed items
                %i.fa.fa-stethoscope
                in any boxes
                %i.fa.fa-box-open

  - if (can? :manage, PackedItem) && (@staged_items.any? || @staged_boxes.any? || @warehoused_items.any? || @warehoused_boxes.any?)
    = render "layouts/mass_action_add", display: %i[items boxes]
