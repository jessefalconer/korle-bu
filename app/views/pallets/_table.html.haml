- pallets ||= @pallets
%table.table.table-striped.table-hover.link-rows
  %thead
    %tr
      %th Custom ID
      %th Name
      %th Status
      %th.d-none.d-md-table-cell Boxes
      %th.d-none.d-sm-table-cell Receiver
      %th.d-none.d-sm-table-cell Created At
      - if can?(:create, Pallet)
        %th.mass-action-cell
  %tbody
    - pallets.each do |pallet|
      %tr
        %td
          = link_to pallet_path(pallet) do
            %p= pallet.custom_uid
        %td
          = link_to pallet_path(pallet) do
            %p= pallet.name
        %td
          = link_to pallet_path(pallet) do
            = status_label(pallet.status)
        %td.d-none.d-md-table-cell
          = link_to pallet_path(pallet) do
            %p{class: (pallet.boxes.size.zero? ? "text-warning" : "text-success")}= pallet.boxes.size
        %td.d-none.d-sm-table-cell
          = link_to pallet_path(pallet) do
            %p= pallet.shipment&.receiving_warehouse&.name
        %td.d-none.d-sm-table-cell
          = link_to pallet_path(pallet) do
            %p= pallet.created_at.strftime("%Y-%m-%d")
        - if can?(:create, Pallet)
          %td.mass-action-cell
            = check_box_tag "pallet_ids[]", pallet.id, false, class: "mass-action-table", form: "mass_action", id: "mass-action-pallet-#{pallet.id}"
