- create_password ||= false
= form_for @user do |f|
  .row
    .col-12.col-sm-6
      .form-group
        %label First Name
        = f.text_field :first_name, class: "form-control"
      .form-group
        %label Last Name
        = f.text_field :last_name, class: "form-control"
      .form-group
        %label Email
        = f.text_field :email, class: "form-control"
      .form-group
        %label Phone Number
        = f.text_field :phone, class: "form-control"
      - unless (cannot? :alter_roles, User) && !@user.masquerader
        .form-group
          %label Role
          = f.select(:role, options_for_select(current_user.admin? ? User::ROLES : User::ROLES - ["Admin"], @user.role), {}, { class: "form-select" })
        .form-group
          %label Status
          = f.select(:status, options_for_select(User::STATUSES, @user.status), {}, { class: "form-select" })
        .form-group
          %label Warehouse
          = f.select(:warehouse_id, options_from_collection_for_select(Warehouse.all.order(:name), :id, :name, @user.warehouse_id), { include_blank: "None" }, { class: "form-select" })
      -if create_password
        .form-group
          %label Temporary Password
          = f.password_field :password, class: "form-control", autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH
          %small.text-muted
            At least #{User::MIN_PASSWORD_LENGTH} characters. Share it with the person privately;
            they'll have to choose their own password at first login.
        .form-group
          %label Confirm Temporary Password
          = f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH

    .col-12.col-sm-6
      .form-group
        %label Notes
        = f.text_area :notes, disabled: current_user.id != @user.id, class: "form-control", style: "height: 475px;"

    .col-12
      .btn-toolbar.list-toolbar
        = submit_button_responsive("Save")
