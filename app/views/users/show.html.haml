.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item
        = link_to "Users", users_path
      %li.breadcrumb-item.active= @user.name
    = render partial: "layouts/jump_to_modal"
    = render partial: "layouts/edit_modal"
    - if current_user == @user
      = link_to edit_password_path, class: "btn btn-primary" do
        %i.fa.fa-user-shield
        %span Change Password
    - elsif can?(:change_password, @user)
      = render partial: "layouts/change_password_modal"
    - if can?(:destroy, @user) && current_user != @user && !@user.created_records?
      = delete_button(user_path(@user), "Are you sure you want to delete #{@user.name}? This cannot be reversed")

  .main-content
    .row.detail-card
      .col-12
        %h5.text-muted Name
        %h4= @user.name
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Email
        %h5= @user.email || "N/A"
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Phone Number
        %h5= @user.phone || "N/A"
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Role
        %h5= @user.role
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Status
        %h5{style: "color: #{@user.active? ? "#02a556" : "#ff4d4d"}"}
          %span.status-pill= @user.status
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Warehouse
        %h5= @user.warehouse&.name || "N/A"
      .col-lg-3.col-sm-4.col-6
        %h6.text-muted Created At
        %h5= @user.created_at.strftime("%Y-%m-%d")
      - if @user.notes.present?
        .col-12
          %h6.text-muted Notes
          %h5= @user.notes
