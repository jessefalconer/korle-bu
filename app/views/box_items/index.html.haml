.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      = present(@box).breadcrumbs_item
    = render partial: "layouts/jump_to_modal"
    = render partial: "layouts/mass_action_modal", locals: {name: @box.name, redirect: box_box_items_path(@box), record: nil}
  .main-content
    %ul.nav.nav-tabs
      - if can? :manage, PackedItem
        %li.nav-item
          %a.nav-link.active{data: {"bs-toggle": "tab"}, href: "#search"} Search
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#new"} New
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#manage-items"}
            Manage
            %span.badge.text-bg-success= @box.box_items.count
      - elsif cannot? :manage, PackedItem
        %li.nav-item
          %a.nav-link.active{data: {"bs-toggle": "tab"}, href: "#manage-items"}
            Inventory
            %span.badge.text-bg-success= @box.box_items.count
      - if can? :manage, UnpackingEvent
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#unpack-items"}
            Unpack
            %span.badge.text-bg-info= @box.box_items.with_inventory.count
        %li.nav-item
          %a.nav-link{data: {"bs-toggle": "tab"}, href: "#history-items"}
            History
            %span.badge.text-bg-secondary= @box.box_items.with_events.count
    .row
      .col-12
        %br
        .tab-content
          - if can? :manage, PackedItem
            .tab-pane.fade#manage-items
              = render "box_items/manage_form"

            .tab-pane.active.show#search
              = render "box_items/search_form"

            .tab-pane.fade#new
              = render "box_items/add_new_form"

          - elsif cannot? :manage, PackedItem
            .tab-pane.active.show#manage-items
              = render "box_items/list"

          - if can? :manage, UnpackingEvent
            .tab-pane.fade#unpack-items
              = render "box_items/unpack_form"

            .tab-pane.fade#history-items
              = render "box_items/history"
