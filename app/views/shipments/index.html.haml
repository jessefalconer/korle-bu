.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active Shipments
    = render partial: "layouts/jump_to_modal"
  .main-content
    %table.table.table-striped.table-hover.link-rows
      %thead
        %tr
          %th Custom ID
          %th Name
          %th Status
          %th.d-none.d-sm-table-cell Receiver
          %th.d-none.d-sm-table-cell Created At
      %tbody
        - @shipments.each do |shipment|
          %tr
            %td
              = link_to shipment_path(shipment) do
                %p= shipment.custom_uid
            %td
              = link_to shipment_path(shipment) do
                %p= shipment.name
            %td
              = link_to shipment_path(shipment) do
                = status_label(shipment.status)
            %td.d-none.d-sm-table-cell
              = link_to shipment_path(shipment) do
                %p= shipment.receiving_warehouse.name
            %td.d-none.d-sm-table-cell
              = link_to shipment_path(shipment) do
                %p= shipment.created_at.strftime("%Y-%m-%d")

    = paginate @shipments, window: 2
