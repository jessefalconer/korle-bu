.content
  .header
    %ul.breadcrumb
      %li.breadcrumb-item
        = link_to "Home", index_path
      %li.breadcrumb-item.active= @shipment.name
    = render partial: "layouts/jump_to_modal"
    - if can? :manage, Shipment
      = render partial: "layouts/edit_modal"
      = render "layouts/export_shipment_modal"
    - if can? :manage, PackedItem
      = render partial: "layouts/mass_action_modal", locals: {name: @shipment.name, redirect: shipment_path(@shipment), record: nil}
    - if can? :destroy, @shipment
      = delete_button(shipment_path(@shipment), "Are you sure you want to delete #{@shipment.name}? This cannot be reversed", record: @shipment)

  .main-content
    .row.detail-layout
      .col-md-5
        .row.detail-card
          .col-12
            %h5.text-muted Name
            %h4= @shipment.name
          - if @shipment.notes.present?
            .col-12
              %h6.text-muted Notes
              %h5= @shipment.notes
          .col-12
            %h6.text-muted Receiving Warehouse
            %h5= @shipment.receiving_warehouse&.name || "N/A"
          .col-12
            %h6.text-muted Shipping Warehouse
            %h5= @shipment.shipping_warehouse&.name || "N/A"
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Custom ID
            %h5= @shipment.custom_uid
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Status
            = status_label(@shipment.status, :h5)
          - stats = @shipment.packed_item_stats
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Items (Unique)
            %h5= stats[:unique_items]
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Items (Instances)
            %h5= stats[:instances]
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Items (Quantity)
            %h5= stats[:quantity]
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Items (Est. Weight)
            %h5 #{stats[:weight]}kg
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Earliest Expiry
            %h5= stats[:earliest_expiry]&.strftime("%Y-%m-%d") || "N/A"
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Latest Expiry
            %h5= stats[:latest_expiry]&.strftime("%Y-%m-%d") || "N/A"
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created By
            %h5= @shipment.user.name
          .col-6.col-sm-4.col-md-6
            %h6.text-muted Created At
            %h5= @shipment.created_at.strftime("%Y-%m-%d")

      .col-md-7
        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#containers"}
            %i.fa.fa-truck
            Containers in this Shipment
            %span.badge{class: @shipment.containers.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.containers.size

          - if @shipment.containers.any?
            .collapse#containers
              %table.table.table-striped.link-rows
                %thead
                  %tr
                    %th Custom ID
                    %th Name
                    %th Status
                %tbody
                  - sorted_desc(@shipment.containers, :custom_uid).each do |container|
                    %tr
                      %td
                        = link_to container_path(container) do
                          %p= container.custom_uid
                      %td
                        = link_to container_path(container) do
                          %p= container.name
                      %td
                        = link_to container_path(container) do
                          = status_label(container.status)
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#containers"}
                %span Close
          - else
            .collapse.card-body#containers
              %h5.text-center
                No containers
                %i.fa.fa-fw.fa-truck
                assigned to this shipment
                %i.fa.fa-fw.fa-ship


        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#container-items"}
            %i.fa.fa-truck
            %i.fa.fa-stethoscope
            Containerized Items
            %span.badge{class: @shipment.container_items.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.container_items.size

          - if @shipment.container_items.any?
            .collapse#container-items
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "containerized-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @shipment.container_items, assoc: "containerized-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#container-items"}
                %span Close
          - else
            .collapse.card-body#container-items
              %h5.text-center
                No packed items
                %i.fa.fa-fw.fa-stethoscope
                in any containers
                %i.fa.fa-fw.fa-truck

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#pallets"}
            %i.fa.fa-pallet
            Pallets Assigned to Containers
            %span.badge{class: @shipment.pallets.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.pallets.size

          - if @shipment.pallets.any?
            .collapse#pallets
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "pallets"}
              = render partial: "pallets/micro_table", locals: {pallets: @shipment.pallets}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#pallets"}
                %span Close
          - else
            .collapse.card-body#pallets
              %h5.text-center
                No pallets
                %i.fa.fa-fw.fa-pallet
                assigned to any containers
                %i.fa.fa-fw.fa-truck

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#pallet-items"}
            %i.fa.fa-pallet
            %i.fa.fa-stethoscope
            Palletized Items
            %span.badge{class: @shipment.pallet_items.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.pallet_items.size

          - if @shipment.pallet_items.any?
            .collapse#pallet-items
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "palletized-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @shipment.pallet_items, assoc: "palletized-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#pallet-items"}
                %span Close
          - else
            .collapse.card-body#pallet-items
              %h5.text-center
                No packed items
                %i.fa.fa-fw.fa-stethoscope
                on any pallets
                %i.fa.fa-fw.fa-pallet

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#pallet_boxes"}
            %i.fa.fa-box-open
            Boxes Assigned to Pallets
            %span.badge{class: @shipment.pallet_boxes.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.pallet_boxes.size

          - if @shipment.pallet_boxes.any?
            .collapse#pallet_boxes
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "pallet-boxes"}
              = render partial: "boxes/micro_table", locals: {boxes: @shipment.pallet_boxes, table_id: "filter-pallet-boxes-table"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#pallet_boxes"}
                %span Close
          - else
            .collapse.card-body#pallet_boxes
              %h5.text-center
                No boxes
                %i.fa.fa-fw.fa-box-open
                assigned to any pallets
                %i.fa.fa-fw.fa-pallet

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#container_boxes"}
            %i.fa.fa-box-open
            Boxes Assigned to Containers
            %span.badge{class: @shipment.container_boxes.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.container_boxes.size

          - if @shipment.container_boxes.any?
            .collapse#container_boxes
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by custom ID...", assoc: "container-boxes"}
              = render partial: "boxes/micro_table", locals: {boxes: @shipment.container_boxes, table_id: "filter-container-boxes-table"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#container_boxes"}
                %span Close
          - else
            .collapse.card-body#container_boxes
              %h5.text-center
                No boxes
                %i.fa.fa-fw.fa-box-open
                assigned to any containers
                %i.fa.fa-fw.fa-truck

        .card
          %a.card-header{data: {"bs-toggle": "collapse"}, href: "#box-items"}
            %i.fa.fa-box-open
            %i.fa.fa-stethoscope
            Boxed Items
            %span.badge{class: @shipment.box_items.any? ? "text-bg-success" : "text-bg-warning"}= @shipment.box_items.size

          - if @shipment.box_items.any?
            .collapse#box-items
              = render partial: "layouts/table_quick_filter", locals: {placeholder: "Filter by name...", assoc: "boxed-items"}
              = render partial: "packed_items/micro_table", locals: {packed_items: @shipment.box_items, assoc: "boxed-items"}
              .close-collapse{data: {"bs-toggle": "collapse"}, href: "#box-items"}
                %span Close
          - else
            .collapse.card-body#box-items
              %h5.text-center
                No packed items
                %i.fa.fa-fw.fa-stethoscope
                in any boxes
                %i.fa.fa-fw.fa-box-open

  - if (can? :manage, PackedItem) && (@staged_items.any? || @staged_boxes.any? || @staged_pallets.any? || @warehoused_items.any? || @warehoused_boxes.any? || @warehoused_pallets.any?)
    = render "layouts/mass_action_add", display: %i[items boxes pallets]
