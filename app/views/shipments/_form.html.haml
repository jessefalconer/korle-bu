= form_for @shipment do |f|
  -# Short fields share rows on wider screens; Notes is last, full width
  .row.form-fields
    .col-12.col-sm-6.col-lg-4
      .form-group
        = f.label :name
        -# Assigned on create (see set_defaults in the model); editable afterwards
        = f.text_field :name, class: "form-control", readonly: f.object.new_record?
        - if f.object.new_record?
          .form-text Assigned automatically. You can rename it after it's created.
    .col-12.col-sm-6.col-lg-4
      .form-group
        %label Custom ID
        = f.number_field :custom_uid, min: 0, class: "form-control", readonly: f.object.new_record?
    .col-12.col-sm-6.col-lg-4
      .form-group
        = f.label :status
        -# New shipments always start In Progress (set_defaults in the model)
        = f.select :status, options_for_select(current_user.selectable_statuses(Shipment), @shipment.status), {}, { class: "form-select", id: "status", disabled: f.object.new_record? }
        - if f.object.new_record?
          .form-text New shipments start In Progress. You can change it after it's created.
    .col-12.col-sm-6.col-lg-4
      .form-group
        = f.label :shipping_warehouse_id
        = f.select :shipping_warehouse_id, options_from_collection_for_select(Warehouse.order(:name), :id, :name, @shipment.shipping_warehouse_id), { include_blank: "" }, { class: "form-select" }
    .col-12.col-sm-6.col-lg-4
      .form-group
        = f.label :receiving_warehouse_id
        = f.select :receiving_warehouse_id, options_from_collection_for_select(Warehouse.order(:name), :id, :name, @shipment.receiving_warehouse_id), { include_blank: "" }, { class: "form-select" }
    .col-12
      .form-group
        = f.label :notes
        = f.text_area :notes, rows: 3, class: "form-control"

  .btn-toolbar.list-toolbar
    = submit_button_responsive("Save")
